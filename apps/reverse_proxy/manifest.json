{
    "schemaVersion": "1.11.0",
    "acapPackageConf": {
        "setup": {
            "appName": "reverse_proxy",
            "vendor": "Axis Communications",
            "runMode": "never",
            "version": "0.0.0"
        },
        "configuration": {
            "httpConfig": [
                {
                    "access": "viewer",
                    "type": "directory"
                }
            ],
            "reverseProxy": [
                {
                    "apiPath": "api/admin",
                    "apiType": "http",
                    "target": "unix:/run/http/reverse_proxy/app.sock",
                    "access": "admin"
                },
                {
                    "apiPath": "api/operator",
                    "apiType": "http",
                    "target": "unix:/run/http/reverse_proxy/app.sock",
                    "access": "operator"
                },
                {
                    "apiPath": "api/viewer",
                    "apiType": "http",
                    "target": "unix:/run/http/reverse_proxy/app.sock",
                    "access": "viewer"
                },
                {
                    "apiPath": "api/anonymous",
                    "apiType": "http",
                    "target": "unix:/run/http/reverse_proxy/app.sock",
                    "access": "anonymous"
                }
            ],
            "settingPage": "index.html"
        }
    }
}
